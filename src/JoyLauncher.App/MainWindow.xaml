<Window x:Class="JoyLauncher.App.MainWindow"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:JoyLauncher.App.Services"
        Title="JoyLauncher"
        Width="1440" Height="900"
        MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
      <Grid x:Name="StandardShell">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0B1322" Padding="18">
            <DockPanel LastChildFill="True">
                <Grid DockPanel.Dock="Top" Margin="4,8,4,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" Background="{StaticResource AccentBrush}" CornerRadius="10" VerticalAlignment="Top">
                        <TextBlock Text="JL" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,1,0,0">
                        <TextBlock Text="JOYLAUNCHER" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="ANDROID DESKTOP" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel DockPanel.Dock="Bottom" Margin="4,18,4,4">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock Text="RUNTIME STATUS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Ellipse Width="8" Height="8" Fill="#F2B85B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="RuntimeStatusText" Text="Checking BlueStacks…" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button Content="▣   Big Picture Mode" Click="BigPictureMode_Click" Margin="0,12,0,5"
                            Background="{StaticResource AccentSoftBrush}" ToolTip="Open the full-screen, controller-friendly launcher (F10 / controller Start)."/>
                    <Button Content="⚙   Settings" Tag="Settings" Click="Navigation_Click" Margin="0,0,0,0"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="DISCOVER" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" Margin="8,0,0,10"/>
                    <Button Content="⌂   Home" Tag="Home" Click="Navigation_Click" Background="{StaticResource AccentSoftBrush}" Margin="0,0,0,5"/>
                    <Button Content="▦   Library" Tag="Library" Click="Navigation_Click" Margin="0,0,0,5"/>
                    <Button Content="◇   Games" Tag="Games" Click="Navigation_Click" Margin="0,0,0,5"/>
                    <Button Content="▻   Entertainment" Tag="Entertainment" Click="Navigation_Click" Margin="0,0,0,5"/>
                    <Button Content="⌕   Search" Tag="Search" Click="Navigation_Click" Margin="0,0,0,5"/>
                    <Button Content="＋   Store" Tag="Store" Click="Navigation_Click" Margin="0,0,0,5"/>
                    <TextBlock Text="ARROWS / D-PAD  ·  ENTER / A  ·  ESC / B" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" Margin="8,14,6,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="38,28,38,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,26">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="PageTitle" Text="Home" FontSize="30" FontWeight="Bold"/>
                    <TextBlock x:Name="PageSubtitle" Text="Everything you play and watch, in one place." Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="{StaticResource SurfaceBrush}" CornerRadius="9" Padding="13,9" VerticalAlignment="Center">
                    <TextBlock Text="●  LOCAL MODE" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </DockPanel>

            <ScrollViewer x:Name="MainContentScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel x:Name="HomeContent">
                        <Border Height="330" CornerRadius="18" Background="#142642" Padding="34" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="0.8*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Grid.Column="0" MaxWidth="570">
                                    <TextBlock Text="FEATURED GAME" Foreground="#8DB8FF" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="MINECRAFT" FontSize="42" FontWeight="ExtraBold" Margin="0,13,0,8"/>
                                    <TextBlock Text="Your world. Your next adventure. Launch your Android games and apps from one unified library." TextWrapping="Wrap" Foreground="#C4D2E6" FontSize="15" LineHeight="24" MaxWidth="520"/>
                                    <Button x:Name="LaunchFeaturedButton" Content="▶   Launch Minecraft" Background="{StaticResource AccentBrush}" Padding="20,13" Margin="0,22,0,0" Width="190" HorizontalAlignment="Left" Click="LaunchFeatured_Click"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#142B49" CornerRadius="16" Margin="20,15,0,15" ClipToBounds="True">
                                    <Grid>
                                        <Ellipse Width="280" Height="280" Fill="#23436D" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Ellipse Width="220" Height="220" Stroke="#4771A4" StrokeThickness="2" Opacity="0.42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Ellipse Width="158" Height="158" Stroke="#4771A4" StrokeThickness="2" Opacity="0.32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Viewbox Width="230" Height="230" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,10">
                                            <Canvas Width="240" Height="240">
                                                <Polygon Points="120,18 205,65 120,112 35,65" Fill="#78B98C"/>
                                                <Polygon Points="35,65 120,112 120,210 35,163" Fill="#367A56"/>
                                                <Polygon Points="120,112 205,65 205,163 120,210" Fill="#245B41"/>
                                                <Polygon Points="52,68 78,82 78,105 52,91" Fill="#9BCFA7" Opacity="0.82"/>
                                                <Polygon Points="91,90 111,101 111,125 91,114" Fill="#286849" Opacity="0.9"/>
                                                <Polygon Points="139,61 165,47 165,72 139,86" Fill="#3B805A" Opacity="0.95"/>
                                                <Polygon Points="146,128 179,110 179,139 146,157" Fill="#1B4937" Opacity="0.9"/>
                                                <Polygon Points="52,125 83,142 83,167 52,150" Fill="#4B9467" Opacity="0.9"/>
                                                <Polygon Points="94,155 111,164 111,188 94,179" Fill="#2A6748" Opacity="0.95"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="JOYLAUNCHER ORIGINAL ART" FontSize="9" FontWeight="SemiBold" Foreground="#A8B5C9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <DockPanel Margin="0,28,0,13">
                            <TextBlock Text="Your library" FontSize="21" FontWeight="Bold"/>
                            <TextBlock x:Name="HomeAppsLabel" Text="SAMPLE APPS" DockPanel.Dock="Right" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" VerticalAlignment="Center"/>
                        </DockPanel>
                        <UniformGrid x:Name="HomeAppGrid" Columns="3"/>
                        <TextBlock x:Name="HomeAppNotice" Text="These are sample tiles, not verified installed apps. Connect BlueStacks ADB to load your actual library." TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,12,0,0"/>
                    </StackPanel>
                    <ContentControl x:Name="DynamicPageContent" Visibility="Collapsed"/>
                </Grid>
            </ScrollViewer>
            <Grid x:Name="PlayPage" Grid.Row="1" Visibility="Collapsed" Background="#080D18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
                    <Button DockPanel.Dock="Left" Content="←  Back to JoyLauncher" Click="ReturnToLauncher_Click"
                            Background="{StaticResource AccentSoftBrush}" Margin="0,0,16,0"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Hide top bar · F11" Click="TogglePlayerFullscreen_Click"
                                Background="{StaticResource AccentSoftBrush}" Margin="8,0,0,0"
                                ToolTip="Send BlueStacks' documented F11 fullscreen toggle. Click again to restore."/>
                        <Button Content="Try experimental embedding" Click="RetryEmbedding_Click"
                                Background="{StaticResource SurfaceBrush}" Margin="8,0,0,0"
                                ToolTip="Temporarily try re-parenting the BlueStacks window. This is experimental."/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PlayingAppTitle" Text="Now playing" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="PlayingStatusText" Text="Preparing the BlueStacks player surface…"
                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Background="#050A13" CornerRadius="12" ClipToBounds="True">
                    <Grid>
                        <services:ExternalWindowHost x:Name="BlueStacksWindowHost" Focusable="True"
                                                     Visibility="Collapsed"/>
                        <Border x:Name="StandalonePlayerNotice" Background="#111B29"
                                CornerRadius="14" Padding="32" HorizontalAlignment="Center"
                                VerticalAlignment="Center" MaxWidth="560">
                            <StackPanel>
                                <TextBlock Text="BLUESTACKS PLAYER · STANDALONE MODE"
                                           FontSize="10" FontWeight="Bold" Foreground="#93C6B6"/>
                                <TextBlock Text="Your game stays in BlueStacks"
                                           FontSize="25" FontWeight="Bold" Foreground="White"
                                           Margin="0,12,0,8"/>
                                <TextBlock x:Name="StandalonePlayerDescription"
                                           Text="JoyLauncher sent the launch request. The BlueStacks player remains in its own window to avoid the experimental embedding path."
                                           FontSize="13" TextWrapping="Wrap" LineHeight="21"
                                           Foreground="#C3CFDC"/>
                                <Button Content="Bring BlueStacks to front"
                                        Click="BringBlueStacksForward_Click"
                                        Width="220" HorizontalAlignment="Left"
                                        Margin="0,20,0,0" Padding="14,10"
                                        Background="{StaticResource AccentSoftBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

      </Grid>
      <Grid x:Name="BigPictureOverlay" Visibility="Collapsed" Panel.ZIndex="100"
            Background="#080D18" Focusable="False">
        <Grid.RowDefinitions>
          <RowDefinition Height="60"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="54"/>
          <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- Console utility bar -->
        <Border Grid.Row="0" Background="#0D1626" BorderBrush="#26364E" BorderThickness="0,0,0,1">
          <DockPanel Margin="34,0,34,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="34" Height="34" CornerRadius="9" Background="#19345F">
                <TextBlock Text="J" FontSize="21" FontWeight="ExtraBold" Foreground="#C9DCFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="JOYLAUNCHER" FontSize="13" FontWeight="ExtraBold" Foreground="White"/>
                <TextBlock Text="GAMING MODE" FontSize="9" FontWeight="SemiBold"
                           Foreground="#83A79A" Margin="0,2,0,0"/>
              </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="⌕" FontSize="22" Padding="11,5" Margin="0,0,7,0"
                      Background="Transparent" ToolTip="Search apps" Click="BigPictureSearch_Click"/>
              <Button Content="⚙" FontSize="17" Padding="11,7" Margin="0,0,14,0"
                      Background="Transparent" ToolTip="Settings" Click="BigPictureSettings_Click"/>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                <Ellipse x:Name="BigPictureNetworkDot" Width="7" Height="7" Fill="#E7B45D"
                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock x:Name="BigPictureNetworkText" Text="ADB OFFLINE" FontSize="10"
                           FontWeight="SemiBold" Foreground="#AAB5C0" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock x:Name="BigPictureClock" Text="--:--" FontSize="13" FontWeight="SemiBold"
                         Foreground="#E8EDF2" VerticalAlignment="Center" Margin="0,0,15,0"/>
              <Border Width="34" Height="34" CornerRadius="17" Background="#3C5550">
                <TextBlock Text="JL" FontSize="11" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Cinematic hero and recent-app rail -->
        <Grid Grid.Row="1" Margin="30,12,30,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="1.08*"/>
            <RowDefinition Height="0.92*"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" CornerRadius="18" ClipToBounds="True"
                  Background="#173B3A" Margin="0,0,0,4">
            <Grid x:Name="BigPictureHeroBackdrop" Background="#10213B">
              <Image x:Name="BigPictureHeroBackgroundImage"
                     Stretch="UniformToFill"
                     Opacity="0.62"
                     Visibility="Collapsed"
                     IsHitTestVisible="False"
                     ImageFailed="BigPictureHeroBackgroundImage_ImageFailed"/>
              <Border x:Name="BigPictureHeroTint" IsHitTestVisible="False">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#E6080D18" Offset="0"/>
                    <GradientStop Color="#B8080D18" Offset="0.48"/>
                    <GradientStop Color="#55080D18" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Ellipse Width="520" Height="520" Fill="#4D8DFF" Opacity="0.13"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,110,0"
                       IsHitTestVisible="False"/>
              <Ellipse Width="380" Height="380" Stroke="#9CCBFF" StrokeThickness="1"
                       Opacity="0.23" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,180,0" IsHitTestVisible="False"/>
              <Ellipse Width="250" Height="250" Stroke="#9CCBFF" StrokeThickness="1"
                       Opacity="0.18" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,245,0" IsHitTestVisible="False"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.15*"/>
                  <ColumnDefinition Width="0.85*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="38,12,0,12"
                            MaxWidth="690">
                  <TextBlock x:Name="BigPictureHeroEyebrow" Text="FEATURED APP · LOCAL LIBRARY"
                             FontSize="11" FontWeight="Bold" Foreground="#A9E6D2"/>
                  <TextBlock x:Name="BigPictureHeroTitle" Text="YOUR LIBRARY"
                             FontSize="43" FontWeight="ExtraBold" Foreground="White"
                             Margin="0,12,0,7" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="BigPictureHeroDescription"
                             Text="Your Android apps, gathered in one controller-friendly place."
                             FontSize="14" Foreground="#D5E3E0" TextWrapping="Wrap"
                             LineHeight="22" MaxWidth="590"/>
                  <Button x:Name="BigPictureLaunchButton" Content="▶   LAUNCH APP"
                          Click="BigPictureLaunch_Click" IsEnabled="False"
                          Width="190" HorizontalAlignment="Left" Padding="18,12"
                          Margin="0,20,0,0" Background="#B6F0D8" Foreground="#10251F"
                          FontSize="13" FontWeight="Bold"/>
                  <TextBlock x:Name="BigPictureStatusText"
                             Text="Connect BlueStacks ADB to load your installed apps."
                             FontSize="10" Foreground="#B8D0CA" Margin="0,11,0,0"
                             TextWrapping="Wrap"/>
                </StackPanel>

                <Grid Grid.Column="1" Margin="18,12,34,12">
                  <Border x:Name="BigPictureHeroArtworkSurface" Width="260" Height="260"
                          CornerRadius="34" Background="#214D45"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                      <Ellipse Width="220" Height="220" Stroke="#C6F5E3" StrokeThickness="1"
                               Opacity="0.24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Ellipse Width="160" Height="160" Stroke="#C6F5E3" StrokeThickness="1"
                               Opacity="0.20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <TextBlock x:Name="BigPictureHeroFallback" Text="J" FontSize="120"
                                 FontWeight="ExtraBold" Foreground="#D3F5E7"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Image x:Name="BigPictureHeroLogo" Width="148" Height="148"
                             Stretch="Uniform" Visibility="Collapsed"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                </Grid>
              </Grid>
              <Border VerticalAlignment="Bottom" Height="90" IsHitTestVisible="False">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00161920" Offset="0"/>
                    <GradientStop Color="#33161920" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Grid>
          </Border>

          <Grid Grid.Row="1" Margin="0,14,0,2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="4,0,4,10">
              <TextBlock Text="Recent Games &amp; Apps" FontSize="18" FontWeight="Bold"
                         Foreground="White"/>
              <TextBlock x:Name="BigPictureAppsCount" DockPanel.Dock="Right"
                         Text="PREVIEW LIBRARY" FontSize="10" FontWeight="SemiBold"
                         Foreground="#AAB5C0" VerticalAlignment="Center"/>
            </DockPanel>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled" Focusable="False"
                          CanContentScroll="True">
              <StackPanel x:Name="BigPictureRecentGamesPanel" Orientation="Horizontal"
                          VerticalAlignment="Top"/>
            </ScrollViewer>
          </Grid>
        </Grid>

        <!-- Feed sections -->
        <Grid Grid.Row="2">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="WHAT'S NEW" Tag="WHAT'S NEW" Click="BigPictureTab_Click"
                    Padding="18,8" Margin="5,0" Background="#19345F" Foreground="#D9E7FF"
                    FontSize="10" FontWeight="Bold"/>
            <Button Content="FRIENDS" Tag="FRIENDS" Click="BigPictureTab_Click"
                    Padding="18,8" Margin="5,0" Background="Transparent"
                    Foreground="#AAB5C0" FontSize="10" FontWeight="Bold"/>
            <Button Content="RECOMMENDED" Tag="RECOMMENDED" Click="BigPictureTab_Click"
                    Padding="18,8" Margin="5,0" Background="Transparent"
                    Foreground="#AAB5C0" FontSize="10" FontWeight="Bold"/>
          </StackPanel>
          <TextBlock x:Name="BigPictureTabStatus" Text="YOUR LOCAL LIBRARY"
                     HorizontalAlignment="Right" VerticalAlignment="Center"
                     Margin="0,0,34,0" Foreground="#6F817F" FontSize="9"
                     FontWeight="SemiBold"/>
        </Grid>

        <!-- Controller legend -->
        <Border Grid.Row="3" Background="#0D1626" BorderBrush="#26364E" BorderThickness="0,1,0,0">
          <DockPanel Margin="34,0,34,0" LastChildFill="False">
            <Button x:Name="BigPictureExitButton" DockPanel.Dock="Left" Content="☰   MENU"
                    Click="ExitBigPicture_Click" Padding="12,7" Background="Transparent"
                    Foreground="#E6ECEF" FontSize="11" FontWeight="Bold"
                    VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="OPTIONS" Foreground="#AAB5C0" FontSize="10"
                         FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,22,0"/>
              <Border Width="21" Height="21" CornerRadius="11" Background="#E6ECEF"
                      Margin="0,0,7,0">
                <TextBlock Text="A" Foreground="#182127" FontWeight="ExtraBold"
                           FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="SELECT" Foreground="#E6ECEF" FontSize="10"
                         FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
              <Border Width="21" Height="21" CornerRadius="11" Background="#E6ECEF"
                      Margin="0,0,7,0">
                <TextBlock Text="B" Foreground="#182127" FontWeight="ExtraBold"
                           FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="BACK" Foreground="#E6ECEF" FontSize="10"
                         FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
</Window>